    {
      "name": "1. Sistema",
      "item": [
        {
          "name": "Status do servidor e do banco",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "status"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.expect(pm.response.code).to.equal(200));",
                  "pm.test(\"json.banco = ok\", () => pm.expect(pm.response.json().banco).to.equal(\"ok\"));"
                ]
              }
            }
          ]
        }
      ]
    },
