# Copie este arquivo para .env e preencha com os dados do seu PostgreSQL local.
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/BANCO?schema=public
DATABASE_URL="postgresql://postgres:SUA_SENHA@localhost:5432/healthcheck_teste?schema=public"

# Porta da API (opcional; padrão 3001 para não conflitar com o Next.js na 3000)
PORT=3001

# Endereço(s) do painel autorizados a consultar a API pelo navegador (CORS).
# Opcional; padrão http://localhost:3000. Mais de um: separe por vírgula.
CORS_ORIGIN=http://localhost:3000
